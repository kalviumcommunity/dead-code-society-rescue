# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Full MongoDB connection string.
# For local development use the default below.
# For production supply a MongoDB Atlas URI.
DATABASE_URL=mongodb://localhost:27017/logitrack

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens.
# REQUIRED — the server will refuse to start if this is not set.
# Use a long, random string in production (e.g. `openssl rand -hex 64`).
JWT_SECRET=replace_this_with_a_long_random_secret

# How long issued tokens remain valid (uses ms/zeit format).
# Default is 12h if not set.
JWT_EXPIRES_IN=12h
