# Server port
PORT=3000

# MongoDB connection string
# Use localhost for local development, Atlas URL for production
DATABASE_URL=mongodb://localhost:27017/logitrack

# JWT secret key for token signing
# IMPORTANT: Must be at least 32 characters long for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-min-32-chars-change-this-in-production

# Environment mode
NODE_ENV=development
