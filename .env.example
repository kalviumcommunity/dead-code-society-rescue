# Server port the app will listen on
PORT=3000

# MongoDB connection string. Use a local instance for development,
# or an Atlas connection string for a hosted database.
DATABASE_URL=mongodb://localhost:27017/logitrack

# Secret used to sign and verify JWTs. Generate your own random value —
# do NOT reuse this placeholder. e.g. run: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
